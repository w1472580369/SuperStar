            "text": ".popDiv .commitment-content-dialog .commitment-details {\n    padding: 24px 0 30px;\n}\n\n.popDiv .commitment-content-dialog .commitment-details .dec {\n    max-height: 500px;\n    padding: 0 32px;\n}\n\n.popDiv .commitment-content-dialog .commitment-details h2 {\n    font-weight: 500;\n    font-size: 20px;\n    line-height: 28px;\n    color: #131B26;\n    text-align: center;\n    margin-bottom: 20px;\n}\n\n.popDiv .commitment-content-dialog .commitment-details .p-style1 {\n    font-weight: 400;\n    font-size: 14px;\n    line-height: 24px;\n    color: #131B26;\n}\n\n.popDiv .commitment-content-dialog .commitment-details .p-style2 {\n    font-weight: 600;\n    font-size: 14px;\n    line-height: 24px;\n    color: #131B26;\n    margin: 20px 0;\n}\n\n.popDiv .commitment-content-dialog .commitment-details .p-style3 {\n    text-align: right;\n    font-weight: 400;\n    font-size: 14px;\n    line-height: 24px;\n    color: #131B26;\n    margin-top: 20px;\n}\n\n.popDiv .commitment-content-dialog .popBottom {\n    -webkit-box-shadow: 0px -1px 0px rgba(240, 240, 240, 0.5);\n    box-shadow: 0px -1px 0px rgba(240, 240, 240, 0.5);\n}\n\n.popDiv .commitment-content-dialog .pCheckbox_label {\n    margin-left: 30px;\n    line-height: 36px;\n    cursor: pointer;\n}\n\n.popDiv .commitment-content-dialog .pCheckbox_label .ipt-checkbox {\n    position: relative;\n    top: 9px;\n    margin-right: 10px;\n}\n\n.course-pop {\n    width: 640px;\n}\n.commitmentBom{\n    border-top: 1px solid #F2F2F2;\n    width:100%;\n    height:108px;\n    padding-top:12px;\n    box-sizing: border-box;\n    text-align: center;\n    position: absolute;\n    bottom: 0;\n}\n.commitSure{\n    text-align: center;\n    color:#474C59;\n    font-size:14px;\n    line-height:20px;\n    cursor: pointer;\n}\n\n.commitSure .ksRadio {\n    width: 15px;\n    height: 15px;\n    margin: -3px 8px 0 0;\n    overflow: hidden;\n    position: relative;\n    display: inline-block;\n    vertical-align: middle;\n}\n\n.commitSure .ksRadio input {\n    width: 15px;\n    height: 15px;\n    filter: alpha(opacity=0);\n    opacity: 0;\n    cursor: pointer;\n    display: block;\n    position: absolute;\n    left: 0;\n    top: 0;\n    z-index: 2;\n}\n\n.commitSure .ksRadio input+i {\n    width: 15px;\n    height: 15px;\n    background: url(/mooc2-ans/images/dxcheck.png) no-repeat;\n    background-size: 100%;\n    overflow: hidden;\n    position: absolute;\n    left: 0;\n    top: 0;\n    z-index: 1;\n}\n\n.commitSure .ksRadio input:checked+i {\n    background: url(/mooc2-ans/images/dxchecked.png) no-repeat;\n    background-size: 100%;\n}\n\n.commitBtn{\n    display:inline-block;\n    width:168px;\n    height:44px;\n    text-align:center;\n    line-height:44px;\n    font-size:14px;\n    color:#fff;\n    box-shadow: 0px 2px 9px 0px #67A1FF80;\n    background: linear-gradient(322.22deg, #5A33FF -34.58%, #6CC7FF 132%);\n    border-radius:99px;\n    margin-top:12px;\n    font-size:16px;\n}\n.opa30 {\n    opacity: 0.3;\n    pointer-events: none\n}\n\n"

5.13%);\n  background: -o-linear-gradient(310.02deg, #6CC7FF -38.96%, #5A33FF 175.13%);\n  background: linear-gradient(139.98deg, #6CC7FF -38.96%, #5A33FF 175.13%);\n  -webkit-box-shadow: 0px 3px 12px rgba(39, 125, 255, 0.3);\n          box-shadow: 0px 3px 12px rgba(39, 125, 255, 0.3);\n  border-radius: 20px;\n  padding: 8px 18px;\n  color: #FFFFFF;\n  font-size: 14px;\n  line-height: 20px;\n}\n\n.course-pop {\n  width: 640px;\n}\n"

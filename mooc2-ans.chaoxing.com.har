            "text": "document.writeln('<link href=\"//mooc2-ans.chaoxing.com/head/template/new-head/header.css?v=1756435585\" type=\"text/css\" rel=\"stylesheet\">');\ndocument.writeln('<script type=\"text/javascript\" src=\"//mooc2-ans.chaoxing.com/head/static/js/jquery-3.6.0.min.js\"></script>');\ndocument.writeln('<script type=\"text/javascript\" src=\"//mooc2-ans.chaoxing.com/head/template/new-head/common.js?v=1756374151\"></script>');\ndocument.writeln('<div class=\"Header\">');\ndocument.writeln('    <a href=\"javascript:;\" class=\"Logo fl\">');\ndocument.writeln('        <img src=\"//mooc2-ans.chaoxing.com/head/template/new-head/images/logo.png\" aria-label=\"Logo\"/>');\ndocument.writeln('    </a>');\ndocument.writeln('    <div class=\"headRight fr\">');\n\ndocument.writeln('        <a href=\"javascript:;\" class=\"smarkcoursemark fl marRight30 canMarkSmarkCourse\" style=\"display: none\" onclick=\"operaMarkSmarkCourse(1)\">标记智慧课程</a>');\ndocument.writeln('        <a href=\"javascript:;\" class=\"smarkcoursemark fl marRight30 cancelmarkSmarkCourse\"  style=\"display: none\" onclick=\"operaMarkSmarkCourse(0)\">解除智慧课程</a>');\n\n        \n    \n            document.writeln('        <div class=\"loginAfter fr\">');\n            document.writeln('            <span class=\"headPic fl\"><a href=\"javascript:;\"><img width=\"100%\" height=\"100%\"');\n            document.writeln('                                                                 src=\"https://photo.chaoxing.com/p/463348713_80\"/></a></span>');\n            document.writeln('            <div class=\"name fl\"><p>胡奥运</p><i class=\"arrowDown\"></i>');\n            document.writeln('                <ul class=\"namelogin\" >');\n            document.writeln('                    <li><a href=\"http://i.mooc.chaoxing.com\"><i class=\"user\"></i>进入空间</a></li>');\n                document.writeln('                 <li><a href=\"javascript:;\" onclick=\"toOnlineSupport()\"><i class=\"lineService\"></i>在线客服</a></li>');\n            document.writeln('                    <li><a href=\"javascript:;\" onclick=\"headLogout()\"><i class=\"eidt\"></i>退出登录</a>');\n            document.writeln('                    </li>');\n            document.writeln('                </ul>');\n            document.writeln('            </div>');\n            document.writeln('        </div>');\ndocument.writeln('    </div>');\ndocument.writeln('</div>');\ndocument.writeln('<script>');\ndocument.writeln('    function headLogin() {');\n            document.writeln('window.location.href = \"http://passport2.chaoxing.com/login?newversion=true&refer=\"+encodeURIComponent(window.location.href);');\ndocument.writeln('    }');\ndocument.writeln('    function headLogout() {');\ndocument.writeln('        window.location.href = \"http://passport2.chaoxing.com/logout.html?refer=http://xzmc.yz.chaoxing.com\";');\ndocument.writeln('    }');\ndocument.writeln('</script>');\ndocument.writeln('<style>');\r\ndocument.writeln('\t.zoh_god { display:none;position:relative; height:30px; border-bottom:1px #aaaa8e solid; background-color:#ffffcc; line-height:30px; font-size:14px; color:#444;}');\r\ndocument.writeln('\t.zoh_god a { color:#06F;}');\r\ndocument.writeln('\t.zoh_close { position:absolute; right:0; top:0; display:inline-block; float:right; width:30px; height:30px; vertical-align:middle; cursor:pointer; background:url(http://xzmc.yz.chaoxing.com/template/default/images/oh_god.gif) center no-repeat;}');\r\ndocument.writeln('  .zoh_100 { position:absolute; display:block; width:100%; height:30px; text-align:center;}');\r\ndocument.writeln('</style>');\r\ndocument.writeln('<div class=\"zoh_god\" id=\"zoh_god\"><span class=\"zoh_100\"><span>为了您更好的参与教学内容，建议您使用更快速的浏览器。</span><a href=\"http://www.fanya.chaoxing.com/static/brower.html\">点击下载更新</a></span><span class=\"zoh_close\" onclick=\"closezoh()\"></span></div>');\r\ndocument.writeln('<script>');\r\ndocument.writeln('\tfunction closezoh(){');\r\ndocument.writeln('\t \tif(confirm(\"我知道了，下次不再提示?\")){ ');\r\ndocument.writeln('\t \t\twriteCookie(\"checkbrower\",\"1\",24);');\r\ndocument.writeln('\t \t}');\t\r\ndocument.writeln('\t document.getElementById(\"zoh_god\").style.display=\"none\";');\r\ndocument.writeln('\t}');\r\ndocument.writeln('    var ua = navigator.userAgent; ');\r\ndocument.writeln('    var s = \"MSIE\";');\r\ndocument.writeln('    var ie11 = \"rv:11.0\";');\r\ndocument.writeln('    var i = ua.indexOf(s);');\r\ndocument.writeln('    var ie = ua.indexOf(ie11);');\r\ndocument.writeln('    var c = getCookie(\"checkbrower\");');\r\ndocument.writeln('    if (i >= 0 && ie<0) {//如果是ie并且不是ie11');\r\ndocument.writeln('       //获取IE版本号   ');\r\ndocument.writeln('        var ver = parseFloat(ua.substr(i + s.length));');\r\ndocument.writeln('        if (ver<8 && c!=\"1\") {');\r\ndocument.writeln('        \tdocument.getElementById(\"zoh_god\").style.display=\"block\";');\r\ndocument.writeln('\t\t}');\r\ndocument.writeln('    }   ');\r\n\r\ndocument.writeln('function writeCookie(name, value, hours){  ');\r\ndocument.writeln('        var expire = \"\";  ');\r\ndocument.writeln('        if(hours != null){  ');\r\ndocument.writeln('          expire = new Date((new Date()).getTime() + hours * 3600000);  ');\r\ndocument.writeln('          expire = \"; expires=\" + expire.toGMTString(); ');\r\ndocument.writeln('        \tif(hours == \"0\"){  ');\r\ndocument.writeln('        \t\texpire = \"\";\t ');\t\t\t\t\t\t\t\r\ndocument.writeln('        \t}  ');\r\ndocument.writeln('          path = \";path=/;domain=chaoxing.com\";');\r\ndocument.writeln('        }  ');\r\ndocument.writeln('        document.cookie = name + \"=\" + escape(value) +path+expire;  ');\r\ndocument.writeln('        }  ');\r\ndocument.writeln('\tfunction getCookie(Name)  ');\r\ndocument.writeln('    {  ');\r\ndocument.writeln('        var search = Name + \"=\" ; ');\r\ndocument.writeln('        if(document.cookie.length > 0)  ');\r\ndocument.writeln('        {  ');\r\ndocument.writeln('            offset = document.cookie.indexOf(search)  ');\r\ndocument.writeln('            if(offset != -1)  ');\r\ndocument.writeln('            {  ');\r\ndocument.writeln('                offset += search.length');\r\ndocument.writeln('                end = document.cookie.indexOf(\";\", offset)  ');\r\ndocument.writeln('                if(end == -1) end = document.cookie.length  ');\r\ndocument.writeln('                return unescape(document.cookie.substring(offset, end))  ');\r\ndocument.writeln('            }  ');\r\ndocument.writeln('            else return \"\"; ');\r\ndocument.writeln('        }  ');\r\ndocument.writeln('    }');\r\ndocument.writeln('</script>');\r\n"

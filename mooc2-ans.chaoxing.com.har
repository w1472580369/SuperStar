hanMax\":'评分范围最小值需小于最大值',\n        \"placeholderTitle\":'输入题干（作文提纲，写作要求，中译英文本等）',\n        \"writingplaceholder\":'输入题干（作文提纲，写作要求等）',\n        \"qbankOk\":'知道了',\n        \"recycleOk\":'确定全部还原？',\n        \"recycleOk1\":'删除后无法恢复，确认全部删除？',\n        \"Putaway\": '收起',\n        \"Spread\": '展开',\n        \"topicTipsAllDelete\": '确认删除？',\n        \"topicTIp6\": '若该知识点下存在子级知识点将一并删除，确认删除？',\n        \"courseDataTopicRelationTip\": '关联知识点后，资料中已关联的知识点将不会保留，会替换为新的知识点，确认关联?',\n        \"createSucc\": '创建成功',\n        \"invalidAction\": '无效的操作',\n        \"selfTestFailed\": '自测试卷生成失败',\n        'exit2':'退出',\n        'questionNotEmpty':'题目不能为空，请先添加题目',\n        'settingNotSave':'当前设置内容未保存，若退出当前页面，可能不会保存您的设置内容',\n        'saveAndExit':'退出并保存',\n        'publish':'发布',\n        'forbidInputTextTips':'请设置允许学生上传的附件类型',\n        'weChatForbidInputTextTips':'微信作答不支持上传附件，请勾选拍照/录像或允许学生输入文本',\n        'gradeStandardTips':'请选择年级标准',\n        'literaryFormTips':'请选择文体',\n        'ruleTips':'请输入评分规则',\n        'Tuda':'答案',\n        'rightChoice':'对',\n        'wrongChoice':'错',\n        'knowledgePoint2':'知识点',\n        'pblScore':'分',\n        'emptyAnswer':'答案为空',\n        'emptyOptionValue':'选项内容为空',\n        'smartCommentNew1': '1.本功能支持导入基础题型：单选题、多选题、填空题、判断题、简答题、组合题型、完型填空、共用选项题。',\n        'smartCommentNew2': '2.若要导入组合题型、完型填空和共用选项题题型，请在题目前后使用一对“{{”、“}}”将内容标出；大题题干和小题题干之间不需要空行；大题和小题题干都需标注题号；小题答案可跟在小题题干后，并用空格与题干内容隔开。范例可参考推荐格式。',\n        'smartCommentNew3': '3.若要导入其他名称题型，可在题干前用“【自定义的题型名称】”标出，如：【名词解释】风雅颂。',\n        'smartCommentNew4': '4.导入支持文本、图片、公式(建议使用DOCX格式文档)。题目结构支持识别答案解析、难易度、知识点、课程目标。',\n        'smartCommentNew5': '5.若识别有误，可在左侧修改题目内容后重新识别，或下载推荐格式，按格式修改后重新导入识别。',\n        'smartCommentNew6': '6.支持编辑区直接输入文本',\n        'addTopicSuccessNew': '添加成功',\n        'addTopicFailTip': '添加失败',\n        'delTopicSuccess': '删除成功',\n        'delTopicFailTip': '删除失败',\n        'setTopicSuccess': '设置成功',\n        'setTopicFail': '设置失败',\n        'editTopicSuccessNew': '编辑成功',\n        'delTopic': '确认删除？',\n        'delTopic2': '若该分类下存在子级分类或知识点将一并删除，确认删除？',\n        'deleteTip1': '若该知识点下存在子级知识点将一并删除，确认删除？',\n        'editTopicFailV2': '编辑失败',\n        'addTopicFail': '添加知识点失败',\n        'scorePointsenterName': '请输入得分点',\n        'scorePointssaveName': '请保存得分点',\n        'scorePointsless10': '请输入少于10个得分点',\n        'scorePointsranging1_100': '请输入1-100的整数',\n        'scorePointsduplicates': '得分点有重复',\n        'scorePointsless50': '得分点名称需少于50个字',\n        'procedureCaseTips':'程序题用例输出不能为空',\n        'importCdTip2':'最多导入 100 个资料文件',\n        'noTopics':'暂无知识点',\n        'Noresultsfound':'暂无搜索结果',\n        'Selected':'已选',\n        'importCdTip6':'请选择要导入的资料',\n        'noContent':'暂无内容',\n        'importFailure':'导入失败',\n        'folderEmpty':'暂不支持下载空文件夹',\n        'finishStandardIntervalTimeNotice':'时间最小值为24小时，最大值为99。只允许填写正整数。',\n        'blankMutexTip':'学生作答每空答案顺序打乱也判正确',\n        'the':'第',\n        'saveQuestionTips':'请先保存当前题目',\n        'saveScoreTips':'需大于0且小于等于100',\n        'appForbidLowversionEnterNotes':'本次考试教师已设置禁止使用低版本手机APP考试，请升级最新版本',\n        'noSupportText' : '含有不支持的表情或字符',\n        'paperRepetitionInutTip': '请输入试卷重复率',\n        'piece': '份',\n        'endDrawing': '结束绘制',\n        'drawingArea': '绘制区域',\n        'globalView2': '全局显示',\n        'navigationView2': '导航显示',\n        'pchoose': '请选择',\n        'noData2': '无数据',\n        'resourceDatabase': '资源已添加到本课资料库',\n        'updateSuccess': '更新成功',\n        'filesLargerk': '文件大于500k',\n        'fileSize1': '文件大小不对。您只能上传小于等于',\n        'fileSize2': '尺寸的图片',\n        'uploadPictures2': '请上传图片',\n        'imageType': '图片类型必须是.gif,jpeg,jpg,png中的一种',\n        'uploadFailed': '上传失败',\n        'courseHeaderLogoOnlySupportFormat': '仅支持jpg/jpeg/gif/png格式',\n        'selectImportFile': '请选择要导入的文件',\n        'importing2': '从云盘导入只能选取一个文件！',\n        'unrecognizedKnowledge': '未识别到知识点',\n        'parseFailed': '识别失败',\n        'identificationSuccessful': '识别成功',\n        'aiImportNameEmpty': '知识点/分类名称不能为空',\n    
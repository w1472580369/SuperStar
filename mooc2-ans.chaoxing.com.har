            "mimeType": "application/javascript",
            "text": "// JavaScript Document\n//左侧导航选中js\n$(function () {\n    // $(\".nav-content ul li\").click(function () {\n    //     $(\".nav-content ul li\").removeClass(\"curNav\")\n    //     $(this).addClass(\"curNav\")\n    // })\n    $(\".name\").hover(function () {\n        $(\".loginCon\").show();\n        $(\".loginCon\").animate({\"height\": \"98px\", \"opacity\": \"1\"}, 400);\n    }, function () {\n        $(\".loginCon\").animate({\"height\": \"0\", \"opacity\": \"0\"}, 400);\n        $(\".loginCon\").hide();\n    })\n\n    $(\".name\").hover(function () {\n        $(\".namelogin\").slideDown();\n    }, function () {\n        $(\".namelogin\").stop(true,false).slideUp();\n    })\n})\n\n"
          },

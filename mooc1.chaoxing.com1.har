            "mimeType": "application/javascript",
            "text": "var codeEditors = {};\n\n// 新增一个对象来存储每个 businessId 对应的 langList\nvar langLists = {};\n\nfunction getMimeType(language, businessId) {\n    return langLists[businessId] && langLists[businessId][language] || 'text/plain';\n}\n\n// 判断是否为 Python 相关语言模式（text/x-python 或 text/x-cython）\nfunction isPythonMode(mimeType) {\n    if (typeof mimeType === 'string') {\n        return mimeType === 'text/x-python' || mimeType === 'text/x-cython';\n    }\n    if (mimeType && mimeType.name) {\n        return mimeType.name === 'text/x-python' || mimeType.name === 'text/x-cython';\n    }\n    return false;\n}\n\n// 根据语言类型动态应用缩进配置\n// Python 模式：4空格缩进，Tab转空格，回车自动缩进\n// 其他语言：2空格缩进\nfunction applyIndentOptions(editor, mimeType) {\n    if (!editor) return;\n    var indentUnit = isPythonMode(mimeType) ? 4 : 2;\n    editor.setOption('indentUnit', indentUnit);\n    editor.setOption('tabSize', indentUnit);\n    var existingKeys = editor.getOption('extraKeys') || {};\n    var newKeys = {};\n    for (var k in existingKeys) {\n        if (existingKeys.hasOwnProperty(k)) {\n            newKeys[k] = existingKeys[k];\n        }\n    }\n    if (isPythonMode(mimeType)) {\n        // Python 模式：禁止使用 Tab 字符，强制转换为空格（避免 TabError）\n        editor.setOption('indentWithTabs', false);\n        // Tab 键：关闭自动补全弹窗后插入 4 个空格\n        newKeys.Tab = function(cm) {\n            if (cm.state.completionActive) {\n                cm.state.completionActive.close();\n            }\n            var spaces = Array(indentUnit + 1).join(' ');\n            cm.replaceSelection(spaces);\n        };\n        // Enter 键：关闭自动补全弹窗后换行并自动缩进\n        // 规则：冒号结尾 或 行首为块关键字（def/class/if/for/while 等），下一行增加一级缩进\n        // 其他行复制上一行缩进\n        newKeys.Enter = function(cm) {\n            if (cm.state.completionActive) {\n                cm.state.completionActive.close();\n            }\n            var cursor = cm.getCursor();\n            var line = cm.getLine(cursor.line);\n            var match = line.match(/^(\\s*)/);\n            var currentIndent = match ? match[1] : '';\n            var trimmed = line.trim();\n            // 完全空行回车：不携带任何缩进\n            if (line.length === 0) {\n                cm.replaceRange('\\n', cursor);\n                return;\n            }\n            // 仅含空格行回车：保留当前缩进级别（替换整行避免累加）\n            if (trimmed.length === 0) {\n                cm.replaceRange('\\n' + currentIndent, {line: cursor.line, ch: 0}, {line: cursor.line, ch: line.length});\n                cm.setCursor({line: cursor.line + 1, ch: currentIndent.length});\n                return;\n            }\n            // Python: 根据光标前的内容判断是否增加缩进\n            // 光标前内容以冒号结尾 或 以块关键字开头，下一行增加一级缩进\n            var beforeCursor = line.substring(0, cursor.ch);\n            var trimmedBefore = beforeCursor.trim();\n            var blockKeywords = /^(def|class|if|elif|else|for|while|try|except|finally|with|async|match|case)\\b/;\n            var targetIndent;\n            if (trimmedBefore.length > 0 && (trimmedBefore.indexOf(':') === trimmedBefore.length - 1 || blockKeywords.test(trimmedBefore))) {\n                targetIndent = currentIndent + '    ';\n            } else {\n                targetIndent = currentIndent;\n            }\n            // 获取光标后面的内容（需要移到下一行）\n            var afterCursor = line.substring(cursor.ch);\n            // 替换光标位置到行尾的内容为换行+缩进+光标后内容\n            cm.replaceRange('\\n' + targetIndent + afterCursor, cursor, {line: cursor.line, ch: line.length});\n            // 将光标定位到新行的缩进末尾\n            cm.setCursor({line: cursor.line + 1, ch: targetIndent.length});\n        };\n    } else {\n        // 非 Python 模式：移除 Tab/Enter 自定义处理器，恢复默认行为\n        delete newKeys.Tab;\n        delete newKeys.Enter;\n    }\n    editor.setOption('extraKeys', newKeys);\n}\n\nfunction createCodeEditor(businessId, options) {\n    var langList = {};\n\n    if (options && options.languages) {\n        var languages = options.languages;\n        if ($.isArray(languages) && languages.length > 0) {\n            $.each(langList, function(key) {\n                delete langList[key];\n            });\n            $(languages).each(function(index, pair) {\n                if (pair.codeName) {\n                    var key = pair.codeName;\n                    var value = pair.code;\n                    langList[key] = value;\n                }\n            });\n        }\n    }\n\n    langLists[businessId] = langList;\n\n    var codeEditor = CodeMirror.fromTextArea($(`.code-editor[data-business-id=\"${businessId}\"]`)[0],{\n        value: \"function myScript(){return 100;}\\n\",\n        mode: \"javascript\",\n        lineNumbers: true,\n        theme: \"default\",\n        hintOptions: {\n            completeSingle: false\n        },\n        autoCloseBrackets: true,\n        matchBrackets: true,\n        autoCloseTags: true,\n        gutters: [\n            \"CodeMirror-linenumbers\",\n            \"CodeMirror-lint-markers\",\n            \"CodeMirror-linenumbers\",\n            \"CodeMirror-foldgutter\"\n        ],\n        foldGutter: true,\n        extraKeys: {\n            \"Ctrl-Space\": \"autocomplete\",\n            \"Ctrl-Q\": function (cm) {\n                cm.foldCode(cm.getCursor());\n            }\n        },\n        foldOptions: {\n            rangeFinder: CodeMirror.fold.brace\n        }\n    });\n\n    codeEditors[businessId] = codeEditor;\n\n    // 初始化时从 DOM 读取当前语言并调用 changeMode\n    var curLangList = $(`.langList[data-business-id=\"${businessId}\"]`);\n    var curCodename = curLangList.attr('codename');\n    if (curCodename && langLists[businessId] && langLists[businessId][curCodename]) {\n        changeMode(curCodename, businessId);\n    }\n\n    // 代码自动补全\n    var notShowArr = '0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_$';\n    codeEditor.on(\"inputRead\", function onChange(editor, change) {\n        if (notShowArr.indexOf(change.text) !== -1) {\n            codeEditor.showHint({completeSingle: false});\n        }\n    });\n\n    // 展开程序语言选择列表\n    $(document).on(\"click\", `.langList[data-business-id=\"${businessId}\"]`, function () {\n        var ul = $(this).find(\"ul\");\n        var display = ul.css(\"display\");\n        var isShow = display !== \"block\";\n\n        $(`.langList[data-business-id=\"${businessId}\"] ul`).hide();\n\n        if (isShow) {\n            $(this).addClass(\"blue-border\");\n            var totalHeight = 0;\n            ul.find(\"li\").each(function() {\n                totalHeight += $(this).height();\n            });\n            ul.slideDown(100);\n        } else {\n            $(this).removeClass(\"blue-border\");\n            ul.slideUp(100);\n        }\n        return false;\n    });\n\n    // 代码格式化\n    $(document).on(\"click\", `.mrconTop .format[data-business-id=\"${businessId}\"]`, function() {\n        var code = codeEditor.getValue();\n        var formattedCode = js_beautify(code);\n        codeEditor.setValue(formattedCode);\n    });\n\n    // 代码重置\n    $(`.mrconTop .refresh[data-business-id=\"${businessId}\"]`).click(function () {\n        $(`.reset-mask[data-business-id=\"${businessId}\"]`).show();\n    });\n\n    // 代码重置\n    $(`.btnReset[data-business-id=\"${businessId}\"]`).click(function (event) {\n        event.preventDefault();\n        codeEditor.setValue(getResetCodeByBusinessId(businessId));\n        codeEditor.getWrapperElement().style.fontSize = 14 + 'px';\n        var curCodename = $(`.langList[data-business-id=\"${businessId}\"]`).attr('codename');\n        changeMode(curCodename, businessId);\n        codeEditor.refresh();\n        $(`.reset-mask[data-business-id=\"${businessId}\"]`).hide();\n    });\n\n    // 代码复制\n    $(document).on(\"click\", `.mrconTop .copy[data-business-id=\"${businessId}\"]`, function () {\n        var currentText = codeEditor.getValue();\n        if (navigator.clipboard && navigator.clipboard.writeText) {\n            navigator.clipboard.writeText(currentText)\n                .then(function() {\n                    toast(window.codeEditorMessages && window.codeEditorMessages.codeCopied || '代码已复制');\n                })\n                .catch(function(err) {\n                    console.error('复制失败', err);\n                });\n        } else {\n            var textarea = $(\"<textarea>\");\n            textarea.val(currentText);\n            $(\"body\").append(textarea);\n            textarea.prop(\"selectionStart\", 0);\n            textarea.prop(\"selectionEnd\", 99999);\n            try {\n                document.execCommand(\"copy\");\n                toast(window.codeEditorMessages && window.codeEditorMessages.codeCopied || '代码已复制');\n            } catch (err) {\n                console.error('复制失败', err);\n            }\n            textarea.remove();\n        }\n    });\n\n    // 编辑器设置\n    $(document).on(\"click\", `.mrconTop .setting[data-business-id=\"${businessId}\"]`, function () {\n        $(`.setting-mask[data-business-id=\"${businessId}\"]`).show();\n    });\n\n    // 字体切换\n    $(document).on(\"click\", `.fontList[data-business-id=\"${businessId}\"] ul li`, function () {\n        var curCodename = $(`.langList[data-business-id=\"${businessId}\"]`).attr('codename');\n        changeMode(curCodename, businessId);\n    });\n\n    // 取消\n    $(`.btnCancle[data-business-id=\"${businessId}\"], .popClose[data-business-id=\"${businessId}\"]`).click(function () {\n        $(`.reset-mask[data-business-id=\"${businessId}\"]`).hide();\n        $(`.setting-mask[data-business-id=\"${businessId}\"]`).hide();\n    });\n\n    // 编辑器确认\n    $(`.btnSetting[data-business-id=\"${businessId}\"]`).click(function (event) {\n        event.preventDefault();\n        var fontSize = $(`.fontList[data-business-id=\"${businessId}\"] > p > span`).text();\n        codeEditor.getWrapperElement().style.fontSize = fontSize;\n        var curCodename = $(`.langList[data-business-id=\"${businessId}\"]`).attr('codename');\n        changeMode(curCodename, businessId);\n        codeEditor.refresh();\n        $(`.setting-mask[data-business-id=\"${businessId}\"]`).hide();\n    });\n\n    // 选择程序语言\n    $(document).on(\"click\", `.langList[data-business-id=\"${businessId}\"] ul li`, function () {\n        var p = $(this).closest('.langList').find(\"p span\");\n        p.text($(this).find(\"a\").text());\n        p.attr(\"value\", $(this).attr(\"value\"));\n        p.css(\"color\", \"#444\");\n        $(`.langList[data-business-id=\"${businessId}\"] ul li`).removeClass(\"boxli_cur\");\n        $(this).addClass(\"boxli_cur\");\n\n        var aEle = $(this).find(\"a\");\n        var codename = aEle.attr(\"codename\");\n        var codenum = aEle.attr(\"codenum\");\n        $(`.langList[data-business-id=\"${businessId}\"]`).attr(\"codenum\", codenum);\n        $(`.langList[data-business-id=\"${businessId}\"]`).attr(\"codename\", codename);\n\n        var languageSelectId = `languageSelect${businessId}`;\n        var languageSelect = $(`#${languageSelectId}`);\n        if (languageSelect.length > 0) {\n            languageSelect.val(codenum);\n        }\n\n        changeMode(codename, businessId);\n        preparedEditorChangeLanguage(businessId);\n    });\n\n    function changeMode(mode, businessId) {\n        var editor = codeEditors[businessId];\n        if (editor) {\n            var mimeType = getMimeType(mode, businessId);\n            editor.setOption(\"mode\", mimeType);\n            applyIndentOptions(editor, mimeType);\n        }\n    }\n}\n\n// 点击语言列表外部区域时收缩列表\n$(document).on(\"click\", function (e) {\n    if (!$(e.target).closest('.langList').length) {\n        $('.langList ul').slideUp(100);\n        $('.langList').removeClass(\"blue-border\");\n    }\n});\n\nfunction initCodeMirror(businessId, options) {\n    createCodeEditor(businessId, options);\n}\n\nfunction getCodeEditorByBusinessId(businessId) {\n    return codeEditors[businessId];\n}\n\nfunction getCodeContentByBusinessId(businessId) {\n    var editor = getCodeEditorByBusinessId(businessId);\n    if (editor) {\n        return editor.getValue();\n    }\n    return \"\";\n}\n\n\nvar toastTimer = null;\nfunction toast(str, time) {\n    time = time || 1000;\n    var toast = $('#toast');\n    if (toast.length) {\n        toast.remove();\n        clearTimeout(toastTimer);\n        toastTimer = null;\n    }\n\n    var toastDiv = $(\"<div>\");\n    toastDiv.attr(\"id\", \"toast\");\n    toastDiv.html(str);\n    $(\"body\").append(toastDiv);\n\n    toastTimer = setTimeout(function() {\n        $('#toast').remove();\n        toastTimer = null;\n    }, time);\n}\n\nfunction setCodeContentByBusinessId(businessId, data) {\n    var editor = getCodeEditorByBusinessId(businessId);\n    if (editor) {\n        editor.setValue(data);\n    }\n}\n\n// 程序题重置代码：当前语言有作答模板时回显对应模板，没有作答模板的语言重置为空\nfunction getResetCodeByBusinessId(businessId) {\n    var codeNum = $('.langList[data-business-id=\"' + businessId + '\"]').attr(\"codenum\");\n    var preparedCodeStr = $('.codeEditorBoxDiv[data-business-id=\"' + businessId + '\"]').attr(\"prepared-code\");\n    if (typeof preparedCodeStr != \"undefined\" && preparedCodeStr != \"\") {\n        try {\n            var preparedCode = JSON.parse(preparedCodeStr);\n            var codeData = preparedCode.find(item => item.codeNum == codeNum);\n            if (typeof codeData != \"undefined\" && codeData != \"\") {\n                return codeData.code || \"\";\n            }\n        } catch (e) {\n        }\n    }\n    return \"\";\n}\n\n// 程序题作答模板切换语言\nfunction preparedEditorChangeLanguage(businessId) {\n    var codeNum = $('.langList[data-business-id=\"'+businessId+'\"]').attr(\"codenum\");\n    var preparedCodeStr = $('.codeEditorBoxDiv[data-business-id=\"'+businessId+'\"]').attr(\"prepared-code\");\n    // 如果是做大模板编辑器则需要记录当前语言的代码，切换语言后回显之前设置的代码\n    if (typeof preparedCodeStr != \"undefined\" && preparedCodeStr != \"\") {\n        try{\n            var preparedCode = JSON.parse(preparedCodeStr);\n            var codeData = preparedCode.find(item => item.codeNum === codeNum);\n            var oriCode = getCodeContentByBusinessId(businessId);\n\n            if(typeof codeData != \"undefined\"&& codeData != \"\"){\n                if(typeof oriCode != \"undefined\" && oriCode != \"\"){\n                    var tips = window.codeEditorMessages && window.codeEditorMessages.replaceCodeConfirm || '教师已设置作答模板，是否确认替换当前代码？';\n                    var confirmText = window.codeEditorMessages && window.codeEditorMessages.confirm || '确认';\n                    var cancelText = window.codeEditorMessages && window.codeEditorMessages.cancel || '取消';\n                    if(typeof workPop == \"function\"){\n                        workPop(tips, confirmText, cancelText, function () {\n                            setCodeContentByBusinessId(businessId, codeData.code);\n                        });\n                    }else {\n                        $(\"#submitConfirmPop .popWord\").html(tips);\n                        $(\"#submitConfirmPop .confirm\").attr('onclick','setCodeContentByBusinessId('+businessId+', '+JSON.stringify(codeData.code)+');$(\"#submitConfirmPop\").fullFadeOut();');\n                        $(\"#submitConfirmPop\").fullFadeIn();\n                    }\n                }else {\n                    setCodeContentByBusinessId(businessId, codeData.code);\n                }\n            }\n        }catch(e){}\n    }\n}"
          },

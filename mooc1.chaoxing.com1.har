          "content": {
            "size": 6093,
            "mimeType": "application/javascript",
            "text": "// 选词填空（type 24）拖拽作答\n$(function () {\n    var fillinBlanksContent = $('.fillBlanksChoose');\n    if (fillinBlanksContent.length == 0) return;\n\n    var fillinBlanksSource;\n\n    fillinBlanksContent.on(\"dragstart\", function (e) {\n        fillinBlanksSource = getFillinBlanksDragSource(e.target);\n    });\n\n    fillinBlanksContent.on(\"dragover\", function (e) {\n        e.preventDefault();\n    });\n\n    fillinBlanksContent.on(\"dragenter\", function (e) {\n        var dropNode = getFillinBlanksNode(e.target);\n        clearFillinBlanksStyle();\n        if (dropNode && dropNode.dataset.drop === 'copy'\n            && isSameFillinBlankQuestion(fillinBlanksSource, dropNode)) {\n            dropNode.classList.add('drop-over');\n        }\n    });\n\n    fillinBlanksContent.on(\"drop\", function (e) {\n        e.preventDefault();\n        var dropNode = getFillinBlanksNode(e.target);\n        clearFillinBlanksStyle();\n\n        if (!fillinBlanksSource) {\n            return;\n        }\n\n        var needRefresh = false;\n        var questionId = fillinBlanksSource.dataset.qid;\n\n        // 拖放到同一题目空位：填入（词库→空 / 空↔空）\n        if (dropNode && dropNode.dataset.drop === 'copy'\n            && isSameFillinBlankQuestion(fillinBlanksSource, dropNode)) {\n            var sourceValue = fillinBlanksSource.childNodes[0] && fillinBlanksSource.childNodes[0].nodeValue;\n            if (typeof sourceValue !== 'undefined' && sourceValue !== null) {\n                sourceValue = sourceValue.replace(/[&<\">']/g, function (a) {\n                    return {\n                        '<': '&lt;',\n                        '&': '&amp;',\n                        '\"': '&quot;',\n                        '>': '&gt;',\n                        \"'\": '&#39;'\n                    }[a];\n                });\n                dropNode.innerHTML = sourceValue;\n                dropNode.classList.add('hasFill');\n                dropNode.dataset.chooseName = fillinBlanksSource.dataset.chooseName;\n                dropNode.draggable = true;\n                needRefresh = true;\n                questionId = dropNode.dataset.qid;\n            }\n        }\n\n        // 源为空位且目标不是自身：清空原空（空↔空 互换，或拖出题干还原）\n        if (fillinBlanksSource.dataset.drop == 'copy' && fillinBlanksSource !== dropNode) {\n            fillinBlanksSource.innerHTML = '';\n            fillinBlanksSource.classList.remove('hasFill');\n            fillinBlanksSource.dataset.chooseName = \"\";\n            fillinBlanksSource.draggable = false;\n            needRefresh = true;\n            if (!questionId) {\n                questionId = fillinBlanksSource.dataset.qid;\n            }\n        }\n\n        if (needRefresh && questionId) {\n            getFillinBlanksDataForQuestion(questionId);\n        }\n    });\n\n    // 初始化：对每道选词填空题更新作答数据\n    $('.fillBlanksChoose').each(function () {\n        var questionId = $(this).attr('data');\n        if (questionId) {\n            getFillinBlanksDataForQuestion(questionId);\n        }\n    });\n});\n\nfunction getFillinBlanksDataForQuestion(questionId) {\n    var fillBlankList = [];\n    var fillBlanks = [];\n    var questionWrap = $('.fillBlanksChoose[data=\"' + questionId + '\"]');\n    if (questionWrap.length == 0) {\n        questionWrap = $('#question' + questionId);\n    }\n    questionWrap.find('.textTarget').each(function () {\n        var ele = this;\n        fillBlankList.push(ele.innerText);\n        var content = \"\";\n        if (typeof (ele.dataset.chooseName) != \"undefined\") {\n            content = ele.dataset.chooseName;\n        }\n        var fillBlank = {\"name\": fillBlanks.length + 1, \"content\": content};\n        fillBlanks.push(fillBlank);\n    });\n\n    questionWrap.find('.blanksBox span').each(function () {\n        var e = this;\n        if (!e.childNodes[0] || typeof e.childNodes[0].nodeValue === 'undefined') {\n            return;\n        }\n        var count = 0;\n        fillBlankList.forEach(function (item) {\n            if (item.trim() == e.childNodes[0].nodeValue.trim()) {\n                count++;\n            }\n        });\n\n        var dropNodeVal = e.childNodes[0].nodeValue;\n        e.innerText = dropNodeVal;\n        if (count > 0) {\n            var iEle = document.createElement(\"i\");\n            iEle.innerText = count;\n            e.appendChild(iEle);\n        }\n    });\n\n    var answerStr = JSON.stringify(fillBlanks);\n    $(\"#answer\" + questionId).val(answerStr);\n    if (typeof loadEditorAnswerd === 'function') {\n        loadEditorAnswerd(questionId, 24);\n    }\n    if (typeof answerContentChange === 'function') {\n        answerContentChange();\n    }\n}\n\nfunction getFillinBlanksNode(node) {\n    while (node) {\n        if (node.dataset && node.dataset.drop) {\n            return node;\n        }\n        node = node.parentNode;\n    }\n}\n\nfunction getFillinBlanksDragSource(node) {\n    while (node && node !== document) {\n        if (node.dataset && node.dataset.qid != null && node.dataset.qid !== '') {\n            var isBlankTarget = node.dataset.drop === 'copy';\n            var isWordOption = node.parentElement && $(node.parentElement).hasClass('blanksBox');\n            if (isBlankTarget || isWordOption) {\n                return node;\n            }\n        }\n        node = node.parentNode;\n    }\n    return null;\n}\n\nfunction isSameFillinBlankQuestion(source, target) {\n    if (!source || !target || !source.dataset || !target.dataset) {\n        return false;\n    }\n    var sourceQid = source.dataset.qid;\n    var targetQid = target.dataset.qid;\n    return sourceQid != null && targetQid != null && String(sourceQid) === String(targetQid);\n}\n\nfunction clearFillinBlanksStyle() {\n    $('.drop-over').each(function () {\n        this.classList.remove('drop-over');\n    });\n}\n\n// 提交前刷新所有选词填空题的答案数据\nfunction updateAllFillinBlanksData() {\n    $('.fillBlanksChoose').each(function () {\n        var questionId = $(this).attr('data');\n        if (questionId) {\n            getFillinBlanksDataForQuestion(questionId);\n        }\n    });\n}\n"
          },

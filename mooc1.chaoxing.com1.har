            "size": 1738,
            "mimeType": "application/javascript",
            "text": "function reportCourse() {\n\tvar groupDomain = getGroupDomain();\n\tvar reportPage = groupDomain + \"/pc/report/reportIndex\";\n\tvar url = encodeURI(window.location.href);\n\tvar params = new Array();\n\n\tparams.push({name:\"type\",value:\"webURL\"});\n\tparams.push({name:\"sourceIdstr\",value:url});\n\tFORM_UTILS.post(reportPage,params,\"_blank\");\n}\n\nfunction reportTopic(uuid) {\n\tvar groupDomain = getGroupDomain();\n\tvar reportPage = groupDomain + \"/pc/report/reportIndex\";\n\tvar params = new Array();\n\n\tparams.push({name:\"type\",value:\"topic\"});\n\tparams.push({name:\"sourceIdstr\",value:uuid});\n\tFORM_UTILS.post(reportPage,params,\"_blank\");\n}\n\nfunction reportTopicReply (uuid, bbsid) {\n\tvar groupDomain = getGroupDomain();\n\tvar reportPage = groupDomain + \"/pc/report/reportIndex\";\n\tvar params = new Array();\n\n\tconst sourceContentObject = { bbsid: bbsid };\n\n\tparams.push({name:\"type\",value:\"reply\"});\n\tparams.push({name:\"sourceIdstr\",value:uuid});\n\tparams.push({\n\t\tname:\"sourceContent\",\n\t\tvalue: JSON.stringify(sourceContentObject)\n\t});\n\tFORM_UTILS.post(reportPage,params,\"_blank\");\n}\n\nfunction reportTask(classId, taskId, userId, type) {\n\tvar groupDomain = getGroupDomain();\n\tvar reportPage = groupDomain + \"/pc/report/reportIndex\";\n\tvar params = [];\n\tvar sourceId = type + \"-\" + classId + \"-\" + taskId;\n\tparams.push({name: \"type\", value: \"homeworkExam\"});\n\tparams.push({name: \"sourceIdstr\", value: sourceId});\n\tvar obj = {bePuid: userId};\n\tparams.push({\n\t\tname: \"sourceContent\", value: obj\n\t});\n\tFORM_UTILS.post(reportPage, params, \"_blank\");\n}\n\nfunction getGroupDomain(){\n\tif (ServerHost && ServerHost.groupDomain) {\n\t\treturn ServerHost.groupDomain;\n\t}\n\t// 兜底,防止有些文件未加载serverHost,影响公网\n\treturn \"https://groupweb.chaoxing.com\";\n}"
          },

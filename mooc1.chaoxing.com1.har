            "text": ".selectBoxLang ul li{\n    position: relative;\n}\n.language_icon{\n    width:16px;\n    height: 16px;\n    background: url(../../../images/codemirror/language_icon.png) no-repeat;\n    background-size: 100% 100%;\n    position: absolute;\n    right: 10px;\n    top: 50%;\n    transform: translateY(-50%);\n    cursor: pointer;\n}\n.phyton_center{\n    padding:20px 30px;\n    height: 400px;\n    overflow: auto;\n    box-sizing: border-box;\n}\n.phyton_center th{\n    padding:10px 20px;\n    background:#F2F4F7;\n    font-weight: normal;\n    font-size:14px;\n    color:#8A8B99\n}\n.phyton_center td{\n    padding:10px 20px;\n    font-size:14px;\n    color:#131B26\n}\n\n.maskTipDiv{\n    z-index:1001\n}\n\n.maskTipDiv .popDiv{\n    top:50%;\n    left:50%;\n    transform: translate(-50%, -50%);\n}\n\n.maskTipDiv .popBottom a {\n    margin-right: 30px;\n    display: inline-block;\n    text-align: center;\n    line-height: 36px;\n    border-radius: 20px;\n    width: 92px;\n    height: 36px;\n    font-size: 14px;\n    color:#3A8BFF;\n    border: 1px solid #8CBCFF;\n}"

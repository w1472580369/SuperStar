.workAttach img, .attach img, .attachNew img, .stuAnswerArea img, .popClose img, .ans-formula-moudle, .no_view)\");\n\t\tfor (var i = 0, len = imgList.size(); i < len; i++) {\n\t\t\t var src = imgList.eq(i).attr(\"src\");\n\t\t\t if(src){\n    \t\t\tvar index = src.indexOf(\"375_1024\");\n    \t\t\tif (index != -1) {\n    \t\t\t\tsrc = src.replace(\"375_1024\", \"origin\");\n    \t\t\t}\n                 var index2 = src.indexOf(\"750_1024\");\n                 if (index2 != -1) {\n                     src = src.replace(\"750_1024\", \"origin\");\n                 }\n    \t\t\timgList.eq(i).attr(\"data-original\", src);\n\t\t   }\n\t\t}\n        $(\".TiMu\").find(\"div img:not(.workAttach img, .attach img, .attachNew img, .stuAnswerArea img, .popClose img, .no_view)\").viewer({\n\t\t\turl : 'data-original',\n\t\t});\n\t})\n  }catch(error){}\n</script><link rel=\"stylesheet\" type=\"text/css\" href=\"//mooc1.chaoxing.com/mooc-ans/mooc2/css/animationQuestion.css\" />\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/js/jquery.nicescroll.min.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/animation-question.js?v=2024-0319-1800\"></script>\n\n\n<input type=\"hidden\" id=\"currentClockId\" value=\"\" /><script type=\"text/javascript\">window.SUPPORT_AUDIO_SETTING = true; window.SUPPORT_AUDIO_CONTROL = true;</script>\r\n<script src=\"//mooc1.chaoxing.com/mooc-ans/js/work/work-audio-playtimes.js?v=2024-0104-1500\"></script>\n\n<input type=\"hidden\" id=\"fromDevice\" value=\"mooc2\"/>\n\n<div class=\"maskDiv\" style=\"display:none;z-index:1000;\" id=\"audioLimitTimesWinNew\">\n    <div class=\"popSetDiv wid440\">\n        <div class=\"popHead RadisTop\">\n            <a href=\"javascript:;\" class=\"popClose fr\" onclick=\"$('#audioLimitTimesWinNew').fullFadeOut();\">\n                <img src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/images/popClose.png\"/>\n            </a>\n            <p class=\"fl fs18 color1\">提示</p>\n        </div>\n        <div class=\"het62\"></div>\n        <p class=\"popWord fs16 color2 audioLimitTimesTip\">此附件仅支持打开 <span></span> 次，你已打开 <span></span> 次，不能再次打开</p>\n        <div class=\"popBottom RadisBom\">\n            <a href=\"javascript:;\" class=\"jb_btn jb_btn_92 fr fs14\" onclick=\"$('#audioLimitTimesWinNew').fullFadeOut();\">知道了</a>\n        </div>\n        <div class=\"het72\"></div>\n    </div>\n</div>\n\n<div class=\"AlertCon02\" style=\"width:400px; height:200px;display:none;\" id=\"audioLimitTimesWin\">\n    <h3 class=\"clearfix\">\n        <a href=\"javascript:;\" class=\"closed02 fr\" onclick=\"WAY.box.hide();$('#audioLimitTimesWin').css('display','none')\" style=\"margin-top:1px;\"></a>\n    </h3>\n    <div class=\"con03\">\n        <p class=\"audioLimitTimesTip\" style=\"margin-top:16px;text-align:left;\">此附件仅支持打开 <span></span> 次，你已打开 <span></span> 次，不能再次打开</p>\n        <div style=\"margin-top:60px;\">\n            <a class=\"bluebtn\" href=\"javascript:;\" onclick=\"WAY.box.hide();$('#audioLimitTimesWin').css('display','none')\">知道了</a>\n        </div>\n    </div>\n</div><script src=\"//mooc1.chaoxing.com/mooc-ans/js/formUtils.js\"></script>\n<script src=\"//mooc1.chaoxing.com/mooc-ans/js/group/reportNew.js?v=2026-0527-1900\"></script><script>\r\nfunction editorPaste(o, html) {\r\n\thtml.html = \"\";\r\n\t$.toast({\r\n\t\ttype : 'notice',\r\n\t\tcontent : \"只能录入不能粘贴!\"\r\n\t});\r\n\treturn false;\r\n}\r\nwindow[\"uid\"] = '463348713';\r\nwindow[\"currentTime\"] = '1790663375303';\r\nwindow[\"uploadEnc\"] = '0e652245bfdca42d241246fdd5bd08ef';\r\n</script>\r\n</head>\r\n<style>\r\n.questionLi img{max-width:100%;}\r\n.dtk .answerBg{display:inline-block;}\r\n.dtk .answerBg:hover{background:none}\r\n.borblue{border:1px solid #3A8BFF !important;}\r\n.borred{border:1px solid #F33F34 !important;}\r\n.blankInpDiv {width: 100%;height: 38px;border-radius: 4px;border: 1px solid #E1EAF4;box-sizing: border-box;-moz-box-sizing: border-box;-webkit-box-sizing: border-box;line-height: 38px;text-overflow: ellipsis;overflow: hidden;padding: 0 10px;white-space: nowrap;}\r\n*{outline: none;}\r\n.ans-cc pre,.ans-cc code{white-space: pre-wrap!important;}\r\n/* aiArea 预留右侧按钮空间后，选项区改用自适应宽度，避免固定750px换行 */\r\n.aiArea .answer_p{width:calc(100% - 60px);}\r\n.aiArea .reading_answer .answer_p{width:calc(100% - 60px);}\r\n.aiArea .filling_answer .stem_answer .answer_p{width:calc(100% - 60px);}\r\n</style>\r\n\t<style>\r\n\t\t.workTextWrap * {\r\n\t\t\twhite-space: normal !important;\r\n\t\t}\r\n\t</style>\r\n<link rel=\"stylesheet\" type=\"text/css\" href=\"//mooc1.chaoxing.com/mooc-ans/mooc2/css/work/questionCommon.css?v=2026-0521-1600\"/>\r\n<body>\r\n<script type=\"text/javascript\">\n\tI18N_WORK = {\n\t\t\"cpResult\": \"测评结果\",\n\t\t\"ylch\": \"遗漏词汇\",\n\t\t\"zqdfx\": \"准确度分析\",\n\t\t\"tasktips1\": \"未达到及格线，请重做\",\n\t\t\"tasktips2\": \"未达到通过标准，请重做\",\n\t\t\"backdohereV2\": \"很遗憾，未达到及格线，请重做\"\n\t};\n</script><style>\n    .TipsverifyBox{padding:30px;}\n    .TipsverifyBox input{display:block;width:160px;height:36px;padding:6px 14px;box-sizing: border-box;border-radius: 4px;}\n    .verifyDiv{width:135px;height:36px;margin:0 16px}\n    .changeOne{line-height:36px;}\n    .border_color {border: 1px solid #D5D7D9;}\n    .verifyInput:hover {border: 1px solid #3A8BFF;}\n    .verifyInput:focus {border: 1px solid #3A8BFF;}\n</style>\n<div class=\"maskDiv verify-mask\" style=\"z-index: 1001;display: none;\">\n    <div class=\"popDiv wid440 Marking\">\n        <div class=\"popHead\">\n            <a href=\"javascript:;\" class=\"popClose fr\" onclick=\"hideWorkVerify();\"><img src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/images/popClose.png\" /></a>\n            <p class=\"fl fs18 colorDeep\">提示</p>\n        </div>\n        <div class=\"het62\"></div>\n        <div class=\"fs14 TipsverifyBox\">\n            <input type=\"text\" class=\"border_color fl verifyInput\" id=\"inputCode\" placeholder=\"请输入验证码\" />\n            <div class=\"fl verifyDiv\"><img width=\"100%\" height=\"100%\"  id=\"workVerifyImg\" src=\"\" onclick=\"workVerifyCode();\"/></div>\n            <a href=\"javascript:;\" class=\"color0 changeOne\" onclick=\"workVerifyCode();\">换一张</a>\n            <div class=\"clear\"></div>\n        </div>\n\n        <div class=\"popBottom\">\n            <a href=\"javascript:;\" class=\"jb_btn jb_btn_92 fr fs14\" onclick=\"verifyCode();\">确定</a>\n            <a href=\"javascript:;\" class=\"btnBlue btn_92_cancel fr fs14\" onclick=\"hideWorkVerify();\">取消</a>\n        </div>\n        <div class=\"het72\"></div>\n    </div>\n</div>\n\n<script>\nfunction showWorkVerify() {\n    workVerifyCode();\n    $(\".verify-mask\").css(\"display\", \"block\");\n}\n\nfunction hideWorkVerify() {\n    $(\".verify-mask\").css(\"display\", \"none\");\n}\n\nfunction submitCheckTimes() {\n    var addTimes = $(\"#addTimes\").val() || 0;\n    var limitWorkSubmitTimes = $(\"#limitWorkSubmitTimes\").val() || 100;\n    if (parseInt(addTimes) > parseInt(limitWorkSubmitTimes)) {\n        showWorkVerify();\n    } else {\n        setTimeout(\"submitWork()\", 500);\n    }\n}\n\nfunction workVerifyCode() {\n    $(\"#workVerifyImg\").attr(\"src\", _HOST_CP2_ + \"/verifyCode/stuWork?\" + new Date().getTime());\n}\n\nfunction verifyCode() {\n\n    var courseId = $(\"#courseId\").val() || 0;\n    var classId = $(\"#classId\").val() || 0;\n    var cpi = $(\"#cpi\").val() || 0;\n    var workId = $(\"#workId\").val() || 0;\n    var answerId = $(\"#answerId\").val() || 0;\n    var inputCode = $(\"#inputCode\").val() || \"\";\n\n    $.ajax({\n        type: \"get\",\n        url: _HOST_CP2_ + \"/work/verify/code\",\n        cache: false,\n        dataType: \"json\",\n        async: false,\n        data: {\n            \"courseId\": courseId,\n            \"classId\": classId,\n            \"cpi\": cpi,\n            \"workId\": workId,\n            \"answerId\": answerId,\n            \"inputCode\": inputCode\n        },\n        success: function (data) {\n            if (!data.status) {\n                workVerifyCode();\n                $(\"#inputCode\").val(\"\");\n                $.toast({\n                    type : 'failure',\n                    content : data.msg\n                });\n            } else {\n                var enc = data.enc;\n                $(\"#workTimesEnc\").val(enc);\n                submitWork();\n            }\n        }\n    });\n}\n</script><div class=\"subNav\">\r\n\t<div class=\"sub-button fr\" id=\"submitFocus\" tabindex=\"-1\">\r\n\t\t\t\t<a href=\"javascript:;\" onclick=\"saveWork();\" class=\"fl\" tabindex=\"0\">暂时保存</a>\r\n\t\t\t\t\t\t\t\t\t\t\t<a href=\"javascript:;\" onclick=\"submitValidate();\" class=\"completeBtn fl\" tabindex=\"0\" role=\"button\">提交</a>\r\n\t\t\t\t\t\t</div>作业</div>\r\n<div class=\"het40\"></div>\r\n\r\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/codemirror.js\"></script>\n\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/clike.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/go.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/javascript.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/css.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/python.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/sql.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/xml.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/highlight.min.js\"></script>\n\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/anyword-hint.min.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/beautify.min.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/brace-fold.min.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/clike.min.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/closebrackets.min.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/closetag.min.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/comment-fold.min.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/foldcode.min.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/foldgutter.min.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/go.min.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/r.min.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/indent-fold.min.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/javascript.min.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/javascript-hint.min.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/javascript-lint.min.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/jshint.min.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/lint.min.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/matchbrackets.min.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/php.min.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/powershell.min.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/ruby.min.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/show-hint.min.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/swift.min.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/vb.min.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/xml.min.js\"></script>\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/js/octave.min.js\"></script>\n\n<link rel=\"stylesheet\" type=\"text/css\" href=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/lib/codemirror.css?v=2024-1101-1900\"/>\n<link rel=\"stylesheet\" type=\"text/css\" href=\"//mooc1.chaoxing.com/mooc-ans/mooc2/css/codemirror/foldgutter.min.css?v=2024-1101-1900\"/>\n<link rel=\"stylesheet\" type=\"text/css\" href=\"//mooc1.chaoxing.com/mooc-ans/mooc2/css/codemirror/lint.min.css?v=2024-1101-1900\"/>\n<link rel=\"stylesheet\" type=\"text/css\" href=\"//mooc1.chaoxing.com/mooc-ans/mooc2/css/codemirror/show-hint.min.css?v=2024-1101-1900\"/>\n<link rel=\"stylesheet\" type=\"text/css\" href=\"//mooc1.chaoxing.com/mooc-ans/mooc2/css/codemirror/common.css?v=2025-0314-1900\"/>\n<link rel=\"stylesheet\" type=\"text/css\" href=\"//mooc1.chaoxing.com/mooc-ans/mooc2/css/codemirror/selfTesting.css?v=2025-1207-1801\"/>\n\n<script src=\"//mooc1.chaoxing.com/mooc-ans/js/jquery.jqote2.min.js\" ></script>\n\n<script type=\"text/javascript\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/codemirror/codeEditor.js?v=2026-0902-1000\"></script>\n<script>\n    window.noNeedCodemirrorInUeditor = true;\n\n    // 国际化\n    window.codeEditorMessages = {\n        codeCopied: '代码已复制',\n        replaceCodeConfirm: '教师已设置作答模板，是否确认替换当前代码？',\n        confirm: '确认',\n        cancel: '取消'\n    };\n</script>\n<link rel=\"stylesheet\" type=\"text/css\" href=\"//mooc1.chaoxing.com/mooc-ans/mooc2/css/codemirror/codemirrorTip.css?v=2026-0714-1900\"/>\n\n<div class=\"maskDiv maskTipDiv \" style=\"display:none;\" id=\"phytonTipBox\">\n    <div class=\"popDiv wid640\">\n        <div class=\"popHead\">\n            <a href=\"javascript:void(0)\" class=\"fr\" style=\"display: inline-block;width: 18px;height: 18px;margin-top: 19px;\"><img\n                    onclick=\"$('#phytonTipBox').hide();\" src=\"//mooc1.chaoxing.com/mooc-ans/images/popClose.png\"></a>\n            <p class=\"fl fs18 colorDeep\">Python 3.6.9<span class=\"fs14\" style=\"color:#8A8B99\">(已安装的第三方库如下)</span></p>\n        </div>\n        <div class=\"het62\"></div>\n        <div class=\"phyton_center\">\n            <table>\n                <thead>\n                <tr>\n                    <th width=\"100\" align=\"left\">名称</th>\n                    <th width=\"100\" align=\"left\">版本</th>\n                    <th align=\"left\">描述</th>\n                </tr>\n                </thead>\n                <tbody>\n                <tr>\n                    <td align=\"left\">Pandas</td>\n                    <td align=\"left\">1.15</td>\n                    <td align=\"left\">数据分析和处理库，提供 DataFrame 等数据结构</td>\n                </tr>\n                <tr>\n                    <td align=\"left\">NumPy</td>\n                    <td align=\"left\">1.95</td>\n                    <td align=\"left\">数值计算库，提供高性能的多维数组和数学函数</td>\n                </tr>\n                <tr>\n                    <td align=\"left\">SciPy</td>\n                    <td align=\"left\">1.54</td>\n                    <td align=\"left\">科学计算库，基于 NumPy，包含统计、优化、信号处理等功能</td>\n                </tr>\n                </tbody>\n            </table>\n        </div>\n        <div class=\"popBottom\">\n            <a href=\"javascript:void(0)\" class=\"isKnowConfirm fr\" onclick=\"$('#phytonTipBox').hide();\">知道了</a>\n        </div>\n        <div class=\"het72\"></div>\n    </div>\n</div>\n\n<div class=\"maskDiv maskTipDiv \" style=\"display:none;\" id=\"phyton312TipBox\">\n    <div class=\"popDiv wid640\">\n        <div class=\"popHead\">\n            <a href=\"javascript:void(0)\" class=\"fr\" style=\"display: inline-block;width: 18px;height: 18px;margin-top: 19px;\"><img\n                    onclick=\"$('#phyton312TipBox').hide();\" src=\"//mooc1.chaoxing.com/mooc-ans/images/popClose.png\"></a>\n            <p class=\"fl fs18 colorDeep\">Python 3.12.12<span class=\"fs14\" style=\"color:#8A8B99\">(已安装的第三方库如下)</span></p>\n        </div>\n        <div class=\"het62\"></div>\n        <div class=\"phyton_center\">\n            <table>\n                <thead>\n                <tr>\n                    <th width=\"100\" align=\"left\">名称</th>\n                    <th width=\"100\" align=\"left\">版本</th>\n                    <th align=\"left\">描述</th>\n                </tr>\n                </thead>\n                <tbody>\n                <tr>\n                    <td align=\"left\">Pandas</td>\n                    <td align=\"left\">2.3.3</td>\n                    <td align=\"left\">数据分析和处理库，提供 DataFrame 等数据结构</td>\n                </tr>\n                <tr>\n                    <td align=\"left\">NumPy</td>\n                    <td align=\"left\"> 2.3.5</td>\n                    <td align=\"left\">数值计算库，提供高性能的多维数组和数学函数</td>\n                </tr>\n                <tr>\n                    <td align=\"left\">SciPy</td>\n                    <td align=\"left\">1.16.3</td>\n                    <td align=\"left\">科学计算库，基于 NumPy，包含统计、优化、信号处理等功能</td>\n                </tr>\n                </tbody>\n            </table>\n        </div>\n        <div class=\"popBottom\">\n            <a href=\"javascript:void(0)\" class=\"isKnowConfirm fr\" onclick=\"$('#phyton312TipBox').hide();\">知道了</a>\n        </div>\n        <div class=\"het72\"></div>\n    </div>\n</div>\n\n\n\n<div class=\"maskDiv maskTipDiv \" style=\"display:none;\" id=\"cTipBox\">\n    <div class=\"popDiv wid640\">\n        <div class=\"popHead\">\n            <a href=\"javascript:void(0)\" class=\"fr\" style=\"display: inline-block;width: 18px;height: 18px;margin-top: 19px;\"><img\n                    onclick=\"$('#cTipBox').hide();\" src=\"//mooc1.chaoxing.com/mooc-ans/images/popClose.png\"></a>\n            <p class=\"fl fs18 colorDeep\">C 语言编译配置</span></p>\n        </div>\n        <div class=\"het62\"></div>\n        <div class=\"phyton_center\">\n            <table>\n                <thead>\n                <tr>\n                    <th width=\"100\" align=\"left\">名称</th>\n                    <th width=\"100\" align=\"left\">版本</th>\n                </tr>\n                </thead>\n                <tbody>\n                <tr>\n                    <td align=\"left\">C语言标准</td>\n                    <td align=\"left\">C11</td>\n                </tr>\n                <tr>\n                    <td align=\"left\">编译器版本</td>\n                    <td align=\"left\">GCC 11</td>\n                </tr>\n                </tbody>\n            </table>\n        </div>\n        <div class=\"popBottom\">\n            <a href=\"javascript:void(0)\" class=\"isKnowConfirm fr\" onclick=\"$('#cTipBox').hide();\">知道了</a>\n        </div>\n        <div class=\"het72\"></div>\n    </div>\n</div>\n<script type=\"text/x-jqote-template\" id=\"codeEditorTpl\">\n    <%\n    var currLanguageName = (this.currLanguageName && this.currLanguageName !== '请选择程序语言') ? this.currLanguageName : '请选择程序语言';\n    var currLanguageIndex = this.currLanguageIndex || -1;\n    var languages = this.languages;\n    var businessId = this.businessId;\n    %>\n\n    <!--弹窗-->\n    <div class=\"maskBox reset-mask\" data-business-id=\"<%= businessId %>\" style=\"display:none\">\n        <div class=\"promptPop\">\n            <div class=\"popHeadNew\">\n                <a href=\"javascript:void(0)\" class=\"popClose fr\" data-business-id=\"<%= businessId %>\"><img src=\"//mooc1.chaoxing.com/mooc-ans/images/popClose.png\"></a>\n                <p>提示</p>\n            </div>\n            <p class=\"popWord2\">代码框将重置为初始状态，正在编辑的代码将清空，确认重置代码？</p>\n            <div class=\"popBottomNew\">\n                <a href=\"javascript:void(0)\" class=\"popbtn_bg btnReset fr\" data-business-id=\"<%= businessId %>\">重置代码</a>\n                <a href=\"javascript:void(0)\" class=\"popbtn_border btnCancle fr\" data-business-id=\"<%= businessId %>\">取消</a>\n            </div>\n        </div>\n    </div>\n\n    <div class=\"maskBox setting-mask\" data-business-id=\"<%= businessId %>\" style=\"display:none\">\n        <div class=\"promptPop\">\n            <div class=\"popHeadNew\">\n                <a href=\"javascript:void(0)\" class=\"popClose fr\" data-business-id=\"<%= businessId %>\"><img src=\"//mooc1.chaoxing.com/mooc-ans/images/popClose.png\"></a>\n                <p>代码编辑器设置</p>\n            </div>\n            <div class=\"popWord2\">\n                <div class=\"flex-start\">\n                    <span>字体设置</span>\n                    <strong class=\"selectBox fontList fontSizeChange\" data-business-id=\"<%= businessId %>\">\n                        <p value=\"0\"><span>14px</span><i class=\"icon-arrow-down2\"></i></p>\n                        <ul class=\"options optionsCon\" style=\"display:none\">\n                            <li><a href=\"javascript:;\">12px</a></li>\n                            <li><a href=\"javascript:;\">14px</a></li>\n                            <li><a href=\"javascript:;\">16px</a></li>\n                            <li><a href=\"javascript:;\">18px</a></li>\n                            <li><a href=\"javascript:;\">20px</a></li>\n                            <li><a href=\"javascript:;\">24px</a></li>\n                            <li><a href=\"javascript:;\">36px</a></li>\n                            <li><a href=\"javascript:;\">48px</a></li>\n                        </ul>\n                    </strong>\n                </div>\n            </div>\n            <div class=\"popBottomNew\">\n                <a href=\"javascript:void(0)\" class=\"popbtn_bg btnSetting fr\" data-business-id=\"<%= businessId %>\">确认</a>\n                <a href=\"javascript:void(0)\" class=\"popbtn_border btnCancle fr\" data-business-id=\"<%= businessId %>\">取消</a>\n            </div>\n        </div>\n    </div>\n\n    <div class=\"mrconBx\" data-business-id=\"<%= businessId %>\">\n        <div class=\"mrconTop\">\n            <div>\n                <i class=\"icon-com fr setting\" data-business-id=\"<%= businessId %>\">\n                    <div class=\"Vector-pop\">\n                        <span>设置</span>\n                        <div class=\"triangle-container\">\n                            <div class=\"triangle\"></div>\n                        </div>\n                    </div>\n                </i>\n                <i class=\"icon-com fr copy\" data-business-id=\"<%= businessId %>\">\n                    <div class=\"Vector-pop\">\n                        <span>复制</span>\n                        <div class=\"triangle-container\">\n                            <div class=\"triangle\"></div>\n                        </div>\n                    </div>\n                </i>\n                <i class=\"icon-com fr refresh\" data-business-id=\"<%= businessId %>\">\n                    <div class=\"Vector-pop\">\n                        <span>重置</span>\n                        <div class=\"triangle-container\">\n                            <div class=\"triangle\"></div>\n                        </div>\n                    </div>\n                </i>\n                <i class=\"icon-com fr format\" data-business-id=\"<%= businessId %>\">\n                    <div class=\"Vector-pop\">\n                        <span>格式化</span>\n                        <div class=\"triangle-container\">\n                            <div class=\"triangle\"></div>\n                        </div>\n                    </div>\n                </i>\n\n                <% if(currLanguageIndex!== -1) { %>\n                <!--mooc2创建的程序题-->\n                <strong class=\"selectBoxLang fl langList\" codenum=\"<%= currLanguageIndex %>\" codename=\"<%= currLanguageName %>\" data-business-id=\"<%= businessId %>\">\n                    <p value=\"0\"><span><%= currLanguageName %></span><i class=\"icon-arrow-down2\"></i></p>\n                    <ul class=\"options \" style=\"display:none\">\n                        <% for(var pair of languages) { %>\n                        <li>\n                            <a href=\"javascript:void(0)\" codename=\"<%= pair.codeName %>\" code=\"<%= pair.code %>\" codenum=\"<%= pair.codenum %>\"><%= pair.codeName %></a>\n                            <% if (pair.codenum == '16') { %>\n                                 <span class=\"language_icon\" onclick=\"$('#phytonTipBox').show();event.stopPropagation();\"></span>\n                            <% } else if (pair.codenum == '1') { %>\n                                 <span class=\"language_icon\" onclick=\"$('#cTipBox').show();event.stopPropagation();\"></span>\n                            <% } else if (pair.codenum == '22') { %>\n                                 <span class=\"language_icon\" onclick=\"$('#phyton312TipBox').show();event.stopPropagation();\"></span>\n                            <% } %>\n                        </li>\n                        <% } %>\n                    </ul>\n                </strong>\n                <% } else { %>\n                <!--mooc1创建的程序题 || 新建的程序题-->\n                <strong class=\"selectBoxLang fl langList\" data-business-id=\"<%= businessId %>\">\n                    <p value=\"0\"><span>请选择程序语言</span><i class=\"icon-arrow-down2\"></i></p>\n                    <ul class=\"options \" style=\"display:none\">\n                        <% for(var pair of languages) { %>\n                        <li>\n                            <a href=\"javascript:void(0)\" codename=\"<%= pair.codeName %>\" code=\"<%= pair.code %>\" codenum=\"<%= pair.codenum %>\"><%= pair.codeName %></a>\n                            <% if (pair.codenum == '16') { %>\n                                  <span class=\"language_icon\" onclick=\"$('#phytonTipBox').show();event.stopPropagation();\"></span>\n                            <% } else if (pair.codenum == '1') { %>\n                                  <span class=\"language_icon\" onclick=\"$('#cTipBox').show();event.stopPropagation();\"></span>\n                            <% } else if (pair.codenum == '22') { %>\n                                  <span class=\"language_icon\" onclick=\"$('#phyton312TipBox').show();event.stopPropagation();\"></span>\n                            <% } %>\n                        </li>\n                        <% } %>\n                    </ul>\n                </strong>\n                <% } %>\n\n                <p class=\"clear\"></p>\n            </div>\n        </div>\n    </div>\n\n\n</script>\n<script type=\"text/javascript\" charset=\"utf-8\" src=\"//mooc1.chaoxing.com/mooc-ans/js/ServerHost.js?v=2020-1225-1627\"></script>\n<script type=\"text/javascript\" charset=\"utf-8\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/editor/ueditor.config.js?v=2025-0904-2027\"></script>\n<script type=\"text/javascript\" charset=\"utf-8\" src=\"//mooc1.chaoxing.com/mooc-ans/mooc2/js/editor/ueditor.all.min.js?v=2026-0918-2026\"></script>\n<script>\n    function getcookie(objname){\n    \tvar arrstr = document.cookie.split(\"; \");\n    \tfor(var i = 0;i < arrstr.length;i ++){\n    \t\tvar temp = arrstr[i].split(\"=\");\n    \t\tif(temp[0] == objname){ \n    \t\t\treturn u
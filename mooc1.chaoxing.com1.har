            "text": "var viewMarkLock = 0;\nfunction isMarkAttachMessageOriginAllowed(event, pageLocation) {\n\tif (!event || !event.origin || !pageLocation) {\n\t\treturn false;\n\t}\n\tvar pageOrigin = pageLocation.origin;\n\tif (!pageOrigin && pageLocation.protocol && pageLocation.host) {\n\t\tpageOrigin = pageLocation.protocol + \"//\" + pageLocation.host;\n\t}\n\treturn event.origin === pageOrigin;\n}\n\nfunction decodeViewMarkAttachPayload(data) {\n\tif (undefined == data || data.length == 0) {\n\t\treturn null;\n\t}\n\ttry {\n\t\tvar content = decodeURIComponent(atob(data));\n\t\tvar obj = JSON.parse(content);\n\t\tif (undefined == obj.questionId || undefined == obj.recordId || obj.questionId === \"\" || obj.recordId === \"\") {\n\t\t\treturn null;\n\t\t}\n\t\treturn obj;\n\t} catch (e) {\n\t\treturn null;\n\t}\n}\n\nfunction resolveMarkQuestionId(questionId, relationQuestionId, exists) {\n\tif (exists(questionId)) {\n\t\treturn questionId;\n\t}\n\tif (relationQuestionId && exists(relationQuestionId)) {\n\t\treturn relationQuestionId;\n\t}\n\treturn questionId;\n}\n\nfunction createViewMarkEntry(data, doc) {\n\tvar entry = doc.createElement(\"span\");\n\tentry.setAttribute(\"data1\", data.questionId);\n\tentry.setAttribute(\"data2\", data.recordId);\n\tentry.setAttribute(\"data4\", data.relationQuestionId || \"\");\n\treturn entry;\n}\n\nfunction viewMark(obj) {\n\tvar questionId = $(obj).attr(\"data1\");\n\tvar recordId = $(obj).attr(\"data2\");\n\tvar creatorId = $(\"#creatorId\").val();\n\tvar workId = $(\"#workId\").val();\n\tvar classId = $(\"#classId\").val();\n\tvar courseId = $(\"#courseId\").val();\n\tvar relationQuestionId = $(obj).parents(\".singleQuesId\").attr(\"data\");\n\tif (!relationQuestionId) {\n\t\trelationQuestionId = $(obj).attr(\"data4\");\n\t}\n\tvar markQuestionId = resolveMarkQuestionId(questionId, relationQuestionId, function(id) {\n\t\treturn $(\"#qb\" + id).length > 0;\n\t});\n\tvar markObj = $(\"#qb\" + markQuestionId);\n\n\tvar nameData = [];\n\t// 拿到所有附件\n\tvar objectId = \"\";\n\t$(markObj).find(\".attach a\").each(function(index, element) {\n\t\tvar name = $(this).text();\n\t\tvar oid = $(this).attr(\"data\");\n\t\tif (undefined == oid) {\n\t\t\tvar url = $(this).attr(\"href\");\n\t\t\tif (undefined != url && url.search(\"objectId\") > -1) {\n\t\t\t\toid = url.substr(url.search(\"objectId\") + 9);\n\t\t\t} else {\n\t\t\t\toid = \"\";\n\t\t\t}\n\t\t}\n\t\tif (undefined == oid || oid.length == 0) {\n\t\t\treturn true;\n\t\t}\n\t\toid = oid.split(\"&\")[0];\n\t\tobjectId += (oid + \",\");\n\t\t\n\t\tvar item = {};\n\t\titem.objectId = oid;\n\t\titem.name = name;\n\t\tnameData.push(item);\n\t});\n\n\t$(markObj).find(\".attachNew\").each(function(index, element) {\n\t\tvar markObj = $(this).children(\"span:first\");\n\t\tif (undefined == markObj) {\n\t\t\treturn true;\n\t\t}\n\t\tvar name = $(markObj).attr(\"name\");\n\t\tvar objStr = $(markObj).attr(\"data\");\n\t\tif (undefined == objStr || objStr.length == 0) {\n\t\t\treturn true;\n\t\t}\n\t\tvar oid = objStr.split(\"&\")[0];\n\t\tobjectId += (oid + \",\");\n\t\t\n\t\tvar item = {};\n\t\titem.objectId = oid;\n\t\titem.name = name;\n\t\tnameData.push(item);\n\t});\n\t\n\t$(markObj).find(\"img:not(.workAttach img, .attach img, .attachNew img)\").each(function() {\n\t\tvar url = $(this).attr(\"src\");\n\t\tvar oid = \"\";\n\t\tif(typeof url != \"undefined\" && url.length > 0) {\n\t\t\toid = getPathObjectId(url);\n\t\t}\n\t\tobjectId += (oid + \",\");\n\t});\n\n\t$(markObj).find(\".attach-iframe\").each(function(index, element) {\n\t\tvar oid = $(this).attr(\"objectid\");\n\t\tvar name = $(this).attr(\"filename\");\n\t\tobjectId += (oid + \",\");\n\n\t\tvar item = {};\n\t\titem.objectId = oid;\n\t\titem.name = name;\n\t\tnameData.push(item);\n\t});\n\n\tif (objectId.length == 0) {\n\t\talert(\"请稍后重试\");\n\t\treturn;\n\t}\n\t\n\tif (viewMarkLock == 1) {\n\t\treturn;\n\t}\n\tviewMarkLock = 1;\n\t\n\t$.ajax({\n\t\turl : _HOST_CP2_ + \"/work/check-attach\",\n\t\ttype : \"get\",\n\t\tdata : {\n\t\t\t\"courseId\" : courseId,\n\t\t\t\"classId\" : classId,\n\t\t\t\"workId\" : workId,\n\t\t\t\"objectId\" : objectId,\n\t\t\t\"questionId\" : questionId,\n\t\t\t\"recordId\" : recordId,\n\t\t\t\"fullScore\" : 0,\n\t\t\t\"score\" : 0,\n\t\t\t\"stuPersonId\" : creatorId,\n\t\t\t\"teacherPersonId\": creatorId,\n\t\t\t\"relationQuestionId\": relationQuestionId\n\t\t},\n\t\tasync : false,\n\t\tdataType : \"json\",\n\t\tsuccess : function(data) {\n\t\t\tif (data.status) {\n\t\t\t\tvar url = data.url + \"&nameData=\" + encodeURIComponent(JSON.stringify(nameData));\n\t\t\t\t//window.open(url);\n\t\t\t\twindow.open(url, \"newwindow\", \"height=\" + screen.availHeight + \",width=\" + screen.availWidth + \",top=0,left=0,toolbar=no,menubar=no,scrollbars=yes,resizable=no,location=no,status=no\");\n\t\t\t} else {\n\t\t\t\talert(\"请稍后重试\");\n\t\t\t}\n\t\t},\n\t\tcomplete: function() {\n\t\t\tviewMarkLock = 0;\n\t\t}\n\t});\n}\n\nvar viewMarkMessageLock = 0;\n$(function () {\n\twindow.addEventListener(\"message\", function (event) {\n\t\tif (!isMarkAttachMessageOriginAllowed(event, window.location)) {\n\t\t\treturn;\n\t\t}\n\t\tvar data = event.data;\n\t\tif (undefined == data) {\n\t\t\treturn;\n\t\t}\n\t\tvar type = data.type;\n\t\tvar name = data.name;\n\t\tif (undefined == type || undefined == name) {\n\t\t\treturn;\n\t\t}\n\t\tif (type == \"viewMarkAttach\") {\n\t\t\tvar markData = decodeViewMarkAttachPayload(name);\n\t\t\tif (markData == null) {\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tif (markData.evalMark == 1) {\n\t\t\t\tviewMarkAttach(name);\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tif (viewMarkMessageLock == 1) {\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tviewMarkMessageLock = 1;\n\t\t\ttry {\n\t\t\t\tviewMark(createViewMarkEntry(markData, document));\n\t\t\t} finally {\n\t\t\t\tsetTimeout(function() {\n\t\t\t\t\tviewMarkMessageLock = 0;\n\t\t\t\t}, 500);\n\t\t\t}\n\t\t}\n\t});\n});\n\nvar viewEvalMarkLock = 0;\nfunction viewMarkAttach(data) {\n\tvar obj = decodeViewMarkAttachPayload(data);\n\tif (obj == null) {\n\t\treturn;\n\t}\n\tvar questionId = obj.questionId;\n\tvar recordId = obj.recordId;\n\tvar evalMark = obj.evalMark || 0;\n\tvar markerId = obj.markerId || 0;\n\tvar relationQuestionId = obj.relationQuestionId || 0;\n\tvar markQuestionId = resolveMarkQuestionId(questionId, relationQuestionId, function(id) {\n\t\treturn $(\"#qb\" + id).length > 0;\n\t});\n\tvar markObj = $(\"#qb\" + markQuestionId);\n\tvar workId = $(\"#workId\").val();\n\tvar courseId = $(\"#courseId\").val();\n\tvar classId = $(\"#classId\").val();\n\tvar studentId = $(\"#creatorId\").val();\n\n\tvar nameData = [];\n\tvar objectId = \"\";\n\t$(markObj).find(\".attach a\").each(function(index, element) {\n\t\tvar name = $(this).text();\n\t\tvar objStr = $(this).attr(\"data\");\n\t\tif (undefined == objStr || objStr.length == 0) {\n\t\t\treturn true;\n\t\t}\n\t\tvar oid = objStr.split(\"&\")[0];\n\t\tobjectId += (oid + \",\");\n\t\tvar item = {};\n\t\titem.objectId = oid;\n\t\titem.name = name;\n\t\tnameData.push(item);\n\t});\n\n\t$(markObj).find(\".attachNew\").each(function (index, element) {\n\t\tvar markObj = $(this).children(\"span:first\");\n\t\tif (undefined == markObj) {\n\t\t\treturn true;\n\t\t}\n\t\tvar name = $(markObj).attr(\"name\");\n\t\tvar objStr = $(markObj).attr(\"data\");\n\t\tif (undefined == objStr || objStr.length == 0) {\n\t\t\treturn true;\n\t\t}\n\t\tvar oid = objStr.split(\"&\")[0];\n\t\tobjectId += (oid + \",\");\n\t\tvar item = {};\n\t\titem.objectId = oid;\n\t\titem.name = name;\n\t\tnameData.push(item);\n\t});\n\n\t$(markObj).find(\".attach-iframe\").each(function(index, element) {\n\t\tvar oid = $(this).attr(\"objectid\");\n\t\tvar name = $(this).attr(\"filename\");\n\t\tobjectId += (oid + \",\");\n\t\tvar item = {};\n\t\titem.objectId = oid;\n\t\titem.name = name;\n\t\tnameData.push(item);\n\t});\n\n\tif(objectId.length == 0) {\n\t\talert(\"请稍后重试\");\n\t\treturn;\n\t}\n\n\tif (viewEvalMarkLock == 1) {\n\t\treturn;\n\t}\n\tviewEvalMarkLock = 1;\n\n\t$.ajax({\n\t\turl : _HOST_CP2_ + \"/work/check-attach\",\n\t\ttype : \"get\",\n\t\tdata : {\n\t\t\t\"courseId\" : courseId,\n\t\t\t\"classId\" : classId,\n\t\t\t\"workId\" : workId,\n\t\t\t\"stuPersonId\" : studentId,\n\t\t\t\"teacherPersonId\" : studentId,\n\t\t\t\"objectId\" : objectId,\n\t\t\t\"questionId\" : questionId,\n\t\t\t\"recordId\" : recordId,\n\t\t\t\"fullScore\" : 0,\n\t\t\t\"score\" : 0,\n\t\t\t\"markerId\" : markerId,\n\t\t\t\"evalMark\" : evalMark,\n\t\t\t\"relationQuestionId\" : relationQuestionId\n\t\t},\n\t\tasync : false,\n\t\tdataType : \"json\",\n\t\tsuccess : function(data) {\n\t\t\tif (data.status) {\n\t\t\t\tvar url = data.url + \"&nameData=\" + encodeURIComponent(JSON.stringify(nameData));\n\t\t\t\twindow.open(url, \"newwindow\", \"height=\" + screen.availHeight + \",width=\" + screen.availWidth + \",top=0,left=0,toolbar=no,menubar=no,scrollbars=yes,resizable=no,location=no,status=no\");\n\t\t\t} else {\n\t\t\t\talert(\"请稍后重试\");\n\t\t\t}\n\t\t},\n\t\tcomplete: function() {\n\t\t\tviewEvalMarkLock = 0;\n\t\t}\n\t});\n}\n"

tRange();\n\t\t\t\t\t\t\t\twhile (!domUtils.isBody(rng.startContainer)\n\t\t\t\t\t\t\t\t\t\t&& !rng.startOffset\n\t\t\t\t\t\t\t\t\t\t&& rng.startContainer[rng.startContainer.nodeType == 3 ? 'nodeValue'\n\t\t\t\t\t\t\t\t\t\t\t\t: 'childNodes'].length) {\n\t\t\t\t\t\t\t\t\trng.setStartBefore(rng.startContainer);\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tvar tmpAddress = rng.createAddress(true);\n\t\t\t\t\t\t\t\taddress.endAddress = tmpAddress.startAddress;\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t});\n\t\tme.addListener('ready', function() {\n\t\t\tdomUtils.on(me.body, 'cut', function() {\n\t\t\t\tvar range = me.selection.getRange();\n\t\t\t\tif (!range.collapsed && me.undoManger) {\n\t\t\t\t\tme.undoManger.save();\n\t\t\t\t}\n\t\t\t});\n\t\t\tdomUtils.on(me.body, browser.ie || browser.opera ? 'keydown'\n\t\t\t\t\t: 'paste', function(e) {\n\t\t\t\tif ((browser.ie || browser.opera)\n\t\t\t\t\t\t&& ((!e.ctrlKey && !e.metaKey) || e.keyCode != '86')) {\n\t\t\t\t\treturn;\n\t\t\t\t}\n\t\t\t\tgetClipboardData.call(me, function(div) {\n\t\t\t\t\tfilter(div);\n\t\t\t\t});\n\t\t\t});\n\t\t});\n\t};\n\t// chrome 下截图复制到编辑器\n\tUE.plugins['pasteimage'] = function () {\n\t\tvar me = this;\n\t\tvar domUtils = UE.dom.domUtils;\n\t\tvar browser = UE.browser;\n\t\tfunction uploadImageAndInsertFile(file, editor) {\n\t\t\tvar me  = editor;\n\t\t\tvar xhr = new XMLHttpRequest(),\n\t\t\t\tfd = new FormData(),\n\t\t\t\tuploadUrl = me.getOpt(\"imageUrl\"),\n\t\t\t\tfileSize = file.size,\n\t\t\t\tpasteImageMaxSize = me.getOpt(\"pasteImageMaxSize\");\n\n\t\t\tif(fileSize > pasteImageMaxSize){\n\t\t\t\talert(\"粘贴图片过大，请选择另存文件上传\");\n\t\t\t\treturn;\n\t\t\t}\n\n\t\t\tvar mask = domUtils.createElement(top.document, 'div', {\n\t\t\t\t'style':\"position:absolute;top:0;left:0;right:0;bottom:0;z-index:9999;\"\n\t\t\t}),tipsWidth=300 ,tipsHeight=60;\n\t\t\tvar topV =(window.screen.height - tipsHeight )/2 + window.scrollY;\n\t\t\tvar leftV =(window.screen.width - tipsWidth )/2 + window.scrollX;\n\n\t\t\tvar tips = domUtils.createElement(top.document, 'div', {\n\t\t\t\t'style':\"position:absolute;width:\" + tipsWidth + \"px;height:\" + tipsHeight + \"px;line-height:\"\n\t\t\t\t\t+ tipsHeight + \"px;text-align:center;border-radius:4px;left:\" + leftV + \"px;top:\" + topV\n\t\t\t\t\t+ \"px;z-index:10000;background:#000;opacity:0.7;color:#fff;\",\n\t\t\t\t'innerHTML': '正在复制截图...'\n\t\t\t});\n\n\t\t\tif(typeof window.uid != \"undefined\") {\n\t\t\t\tfd.append(\"uid\", window.uid);\n\t\t\t}\n\t\t\tfd.append(\"upfile\", file, file.name || ('blob.' + file.type.substr('image/'.length)));\n\t\t\txhr.open('POST', uploadUrl, true);\n\t\t\txhr.onload = function () {\n\t\t\t\tme.isUploadingPasteImage = false;\n\n\t\t\t\ttop.document.documentElement.removeChild(mask);\n\t\t\t\ttop.document.documentElement.removeChild(tips);\n\n\t\t\t\tvar responseText = xhr.responseText;\n\t\t\t\tvar data = eval('(' + responseText + ')');\n\n\t\t\t\tif ('SUCCESS' != data.state) {\n\t\t\t\t\treturn;\n\t\t\t\t}\n\n\t\t\t\tvar img = new Image();\n\t\t\t\tme.selection.getRange().insertNode(img);\n\t\t\t\timg.src = data.url;\n\t\t\t\tme.undoManger.save();\n\t\t\t};\n\n\t\t\tme.isUploadingPasteImage = true;\n\t\t\ttop.document.documentElement.appendChild(mask);\n\t\t\ttop.document.documentElement.appendChild(tips);\n\n\t\t\txhr.send(fd);\n\t\t}\n\n\t\tfunction getPasteImage(e){\n\t\t\tvar imgs = [];\n\t\t\tif(!e.clipboardData || !e.clipboardData.items){\n\t\t\t\treturn imgs;\n\t\t\t}\n\t\t\tvar length = e.clipboardData.items.length;\n\t\t\tfor (var i = 0; i < length; i++) {\n\t\t\t\t\tif(/^image\\//.test(e.clipboardData.items[i].type)){\n\t\t\t\t\t\timgs.push(e.clipboardData.items[i]);\n\t\t\t\t\t}\n\t\t\t}\n\t\t\treturn imgs;\n\t\t}\n\t\t\n\t\tfunction dataURLtoBlob(imgData) {\n\t\t    var arr = imgData.split(',');\n\t\t    var mime = arr[0].match(/:(.*?);/)[1];\n\t\t    var bytes =atob(arr[1]);     \n\t\t    var array = [];\n\t\t    for (var i = 0; i < bytes.length; i++){\n\t\t       array.push(bytes.charCodeAt(i));\n\t\t    }\n\t\t    var blob = new Blob([new Uint8Array(array)], {type:  mime});\n\t\t\treturn blob;\n\t\t}\n\t\t\n\t\tme.addListener('ready', function () {\n\t\t\tdomUtils.on(me.body, browser.ie || browser.opera ? 'keydown' : 'paste', function (e) {\n\t\t\t\tif ((browser.ie || browser.opera) && ((!e.ctrlKey && !e.metaKey) || e.keyCode != '86')) {\n\t\t\t\t\te.preventDefault();\n\t\t\t\t\treturn false ;\n\t\t\t\t}\n\t\t\t\tif(me.options && !me.options.disablePasteImage){\n\t\t\t\t\tif (me.isUploadingPasteImage) {\n\t\t\t\t\t\te.preventDefault();\n\t\t\t\t\t\treturn false;\n\t\t\t\t\t}\n\t\t\t\t\tvar items = getPasteImage(e);\n\t\t\t\t\tif(items.length == 0){\n\t\t\t\t\t\tsetTimeout(function(){\n\t\t\t\t\t\t\tvar imgs = e.target.getElementsByTagName('img');\n\t\t\t\t\t        for(var i = 0 ; i < imgs.length; i++ ){\n\t\t\t\t\t        \tvar img = imgs[i];\n\t\t\t\t\t        \tvar src = img.getAttribute('src');\n\t\t\t\t\t        \tif(src && src.indexOf('data:image') > -1){\n\t\t\t\t\t\t        \tdomUtils.remove(img);\n\t\t\t\t\t\t        \tvar file = dataURLtoBlob(src);\n\t\t\t\t\t\t        \tuploadImageAndInsertFile(file,me);\n\t\t\t\t\t        \t}\n\t\t\t\t\t        }\n\t\t\t\t\t\t},100);\n\t\t\t\t\t\treturn false;\n\t\t\t\t\t}\n\t\t\t\t\tfor(var i = 0; i < items.length; i++){\n\t\t\t\t\t\t  var item = items[i];\n\t\t\t\t\t\tif (!item || !item.getAsFile) {\n\t\t\t\t\t\t\tcontinue;\n\t\t\t\t\t\t}\n\t\t\t\t\t\tvar file = item.getAsFile();\n\t\t\t\t\t\tif(file){\n\t\t\t\t\t\t\tuploadImageAndInsertFile(file,me);\n\t\t\t\t\t\t}else{\n\t\t\t\t\t\t\talert(\"仅支持截图、文本的粘贴\");\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\te.preventDefault();\n\t\t\t\t}\n\t\t\t});\n\t\t    if(typeof(me.body.draggable) != 'undefined' && !me.options.disableDraggable){\n\t\t\t\tme.body.ondrop = function (event) {\n\t\t\t\t\ttry{\n\t\t\t\t\t\tvar files = event.dataTransfer.files;\n\t\t\t\t\t\tfor(var i = 0 ; i < files.length;i++){\n\t\t\t\t\t\t\tvar fileItem = files.item(i);\n\t\t\t\t\t\t\tif(fileItem &&
          "content": {
            "size": 1832,
            "mimeType": "text/css",
            "text": "/** 作业支持选词填空 */\n.fillBlanks {\n    margin: 0 auto;\n    user-select: none;\n}\n\n.fillBlanks .textContent {\n    color: #131B26;\n    font-size: 14px;\n    line-height: 22px;\n    margin: 0 20px;\n}\n\n.fillBlanks .textContent .textTarget {\n    display: inline-block;\n    padding: 3px 20px;\n    margin: 0 3px;\n    border-bottom: solid 1px #131B26;\n    min-height: 19px;\n    vertical-align: bottom;\n}\n\n.fillBlanks .textContent .textTarget.hasFill {\n    padding: 0;\n    color: #3A8BFF;\n    border: none;\n    cursor: move;\n    border-bottom: 1px solid rgba(255, 255, 255, 0);\n}\n\n.fillBlanks .textContent .textTarget.hasFill:hover {\n    border-bottom: solid 1px #3A8BFF;\n}\n\n.fillBlanks .tips {\n    color: #131B26;\n    font-size: 14px;\n    font-weight: 600;\n    line-height: 20px;\n    padding: 16px 0 10px 0;\n    margin: 0 20px;\n}\n\n.fillBlanks .blanksBox {\n    background: #F7F8FA;\n    border-radius: 4px;\n    padding: 14px 0 0 14px;\n    margin: 0 20px;\n}\n\n.fillBlanks .blanksBox span {\n    display: inline-block;\n    background: #fff;\n    border: solid 1px #DADFE5;\n    border-radius: 4px;\n    color: #3A8BFF;\n    line-height: 18px;\n    font-size: 12px;\n    padding: 6px 14px;\n    margin-bottom: 16px;\n    margin-right: 14px;\n    position: relative;\n    cursor: move;\n}\n\n.fillBlanks .blanksBox span:hover {\n    border: solid 1px #3A8BFF;\n}\n\n.fillBlanks .blanksBox span i {\n    min-width: 12px;\n    height: 12px;\n    position: absolute;\n    top: -6px;\n    right: -6px;\n    font-size: 12px;\n    font-style: normal;\n    color: #ffffff;\n    background-color: #3A8BFF;\n    border-radius: 6px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n}\n\n.fillBlanks .textContent .textTarget.drop-over {\n    border-bottom: 1px solid #3A8BFF;\n}\n\n.fillBlanks .blanksBox.drop-over {\n    background-color: rgba(0, 0, 0, 0.3);\n}"
          },
